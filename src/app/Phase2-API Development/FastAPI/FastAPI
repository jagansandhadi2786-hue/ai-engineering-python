documents = []


@app.post("/documents")
async def upload_document(
    file: UploadFile = File(...)
):

    document_id = (
        f"DOC{len(documents) + 1:03d}"
    )

    document = {
        "document_id": document_id,
        "filename": file.filename,
        "content_type": file.content_type,
        "status": "uploaded",
    }

    documents.append(document)

    return document


