# ============================================================
# EXERCISE 21 - CUSTOMER VALIDATION
# ============================================================
# Task:
# Create a function that validates a customer.
#
# Required:
# - id
# - name
# - age
#
# Age must be greater than 0.
# ============================================================

def validate_customer(customer):

    if "id" not in customer:
        raise KeyError("Customer ID is missing.")

    if "name" not in customer:
        raise KeyError("Customer name is missing.")

    if "age" not in customer:
        raise KeyError("Customer age is missing.")

    if customer["age"] <= 0:
        raise ValueError("Customer age must be greater than 0.")

    return True


customer = {
    "id": 101,
    "name": "Jagan",
    "age": 30
}

try:
    validate_customer(customer)
    print("Customer is valid.")

except KeyError as e:
    print("Missing field:", e)

except ValueError as e:
    print("Invalid value:", e)


