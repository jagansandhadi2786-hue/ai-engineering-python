# ============================================================
# EXERCISE 08 - ELSE
# ============================================================
# Task:
# Use try, except and else.
#
# else should execute only when there is no error.
# ============================================================

try:
    number = int(input("Enter number: "))

except ValueError:
    print("Invalid input.")

else:
    print("Valid number:", number)
    print("Square:", number * number)


