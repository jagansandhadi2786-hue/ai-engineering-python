# EXERCISE 25 - MINI PROJECT
# CUSTOMER ORDER PROCESSOR
# ============================================================
#
# Business Scenario:
# Process a customer order.
#
# Required fields:
# - order_id
# - customer_id
# - amount
# - currency
#
# Validation:
# - order_id must exist
# - customer_id must exist
# - amount must exist
# - amount must be greater than 0
# - currency must exist
#
# Use:
# - try
# - except
# - else
# - finally
# - raise
#
# ============================================================


def process_order(order):

    # Validate order_id
    if "order_id" not in order:
        raise KeyError("Order ID is missing.")

    # Validate customer_id
    if "customer_id" not in order:
        raise KeyError("Customer ID is missing.")

    # Validate amount
    if "amount" not in order:
        raise KeyError("Amount is missing.")

    # Validate amount value
    if order["amount"] <= 0:
        raise ValueError("Amount must be greater than 0.")

    # Validate currency
    if "currency" not in order:
        raise KeyError("Currency is missing.")

    return True


# Sample Order

order = {
    "order_id": "ORD1001",
    "customer_id": "C101",
    "amount": 500,
    "currency": "INR"
}


try:

    process_order(order)

except KeyError as e:

    print("Order processing failed.")
    print("Reason:", e)

except ValueError as e:

    print("Order processing failed.")
    print("Reason:", e)

else:

    print("Order processed successfully.")
    print("Order ID:", order["order_id"])
    print("Customer ID:", order["customer_id"])
    print("Amount:", order["amount"])
    print("Currency:", order["currency"])

finally:

    print("Order processing completed.")


