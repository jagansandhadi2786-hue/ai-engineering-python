# EXERCISE 25 - MINI PROJECT
# CUSTOMER ORDER JSON
# ============================================================

print("\n========== EXERCISE 25 ==========")


# ------------------------------------------------------------
# STEP 1 - Create Order
# ------------------------------------------------------------

order = {

    "order_id": "ORD1001",

    "customer": {

        "customer_id": "C101",

        "name": "Rahul",

        "city": "Hyderabad"
    },

    "order_type": "B2B",

    "currency": "INR",

    "amount": 50000,

    "items": [

        {
            "product_id": "P101",
            "product_name": "Laptop",
            "quantity": 2,
            "price": 50000
        },

        {
            "product_id": "P102",
            "product_name": "Mouse",
            "quantity": 2,
            "price": 1000
        }
    ],

    "status": "NEW"
}


# ------------------------------------------------------------
# STEP 2 - Save Order to JSON File
# ------------------------------------------------------------

with open("customer_order.json", "w") as file:

    json.dump(
        order,
        file,
        indent=4
    )

print("customer_order.json created")


# ------------------------------------------------------------
# STEP 3 - Read JSON File
# ------------------------------------------------------------

with open("customer_order.json", "r") as file:

    data = json.load(file)


# ------------------------------------------------------------
# STEP 4 - Print Order ID
# ------------------------------------------------------------

print("\nOrder ID:",
      data["order_id"])


# ------------------------------------------------------------
# STEP 5 - Print Customer Information
# ------------------------------------------------------------

print("\nCustomer Information")

print("Customer ID:",
      data["customer"]["customer_id"])

print("Name:",
      data["customer"]["name"])

print("City:",
      data["customer"]["city"])


# ------------------------------------------------------------
# STEP 6 - Print Order Type
# ------------------------------------------------------------

print("\nOrder Type:",
      data["order_type"])


# ------------------------------------------------------------
# STEP 7 - Print Currency and Amount
# ------------------------------------------------------------

print("Currency:",
      data["currency"])

print("Amount:",
      data["amount"])


# ------------------------------------------------------------
# STEP 8 - Print All Products
# ------------------------------------------------------------

print("\nOrder Items")

for item in data["items"]:

    print("--------------------")

    print("Product ID:",
          item["product_id"])

    print("Product:",
          item["product_name"])

    print("Quantity:",
          item["quantity"])

    print("Price:",
          item["price"])


# ------------------------------------------------------------
# STEP 9 - Update Order Status
# ------------------------------------------------------------

data["status"] = "PROCESSED"

print("\nNew Status:",
      data["status"])


# ------------------------------------------------------------
# STEP 10 - Add Integration Status
# ------------------------------------------------------------

data["integration_status"] = "SUCCESS"

print("Integration Status:",
      data["integration_status"])


# ------------------------------------------------------------
# STEP 11 - Save Updated Order
# ------------------------------------------------------------

with open("customer_order.json", "w") as file:

    json.dump(
        data,
        file,
        indent=4
    )

print("\nCustomer order updated successfully")


# ------------------------------------------------------------
# STEP 12 - Display Final JSON
# ------------------------------------------------------------

print("\nFinal Customer Order:")

print(
    json.dumps(
        data,
        indent=4
    )
)


