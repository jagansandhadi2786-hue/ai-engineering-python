# ============================================================
# EXERCISE 24 - Write JSON file
# ============================================================

import json

customer_data = {
    "customer_id": "C101",
    "name": "Jagan",
    "country": "India",
    "skills": [
        "Python",
        "SAP CPI",
        "AI Engineering"
    ]
}

with open("05_customer.json", "w") as file:
    json.dump(customer_data, file, indent=4)

print("\nExercise 24 completed")


# ============================================================
# EXERCISE 25 - Read JSON file
# ============================================================

with open("05_customer.json", "r") as file:
    customer = json.load(file)

print("\nExercise 25")

print("Customer ID:", customer["customer_id"])
print("Name:", customer["name"])
print("Country:", customer["country"])
print("Skills:", customer["skills"])


