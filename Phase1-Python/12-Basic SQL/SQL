""")

rows = cursor.fetchall()

for row in rows:
    print(row)


# ============================================================
# EXERCISE 22 - INNER JOIN
# ============================================================
#
# THEORY:
#
# JOIN combines data from multiple tables.
#
# INNER JOIN returns matching records from both tables.
#
# Here:
#
# customers.customer_id
#         =
# orders.customer_id
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 22 - INNER JOIN")
print("=" * 70)

cursor.execute("""
SELECT
    customers.name,
    orders.product,
    orders.amount
FROM customers
INNER JOIN orders
ON customers.customer_id = orders.customer_id
""")

rows = cursor.fetchall()

for row in rows:
    print(row)


