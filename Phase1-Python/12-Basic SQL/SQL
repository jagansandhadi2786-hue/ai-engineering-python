#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 25 - CUSTOMER ORDER MINI PROJECT")
print("=" * 70)


# ------------------------------------------------------------
# 25.1 - Display all customers
# ------------------------------------------------------------

print("\n--- ALL CUSTOMERS ---")

cursor.execute("""
SELECT *
FROM customers
""")

for row in cursor.fetchall():
    print(row)


# ------------------------------------------------------------
# 25.2 - Display all orders
# ------------------------------------------------------------

print("\n--- ALL ORDERS ---")

cursor.execute("""
SELECT *
FROM orders
""")

for row in cursor.fetchall():
    print(row)


# ------------------------------------------------------------
# 25.3 - Customer + Order Information
# ------------------------------------------------------------

print("\n--- CUSTOMER ORDERS ---")

cursor.execute("""
SELECT
    customers.name,
    customers.city,
    orders.product,
    orders.amount,
    orders.status
FROM customers
INNER JOIN orders
ON customers.customer_id = orders.customer_id
""")

for row in cursor.fetchall():
    print(row)


# ------------------------------------------------------------
# 25.4 - Total Sales
# ------------------------------------------------------------

print("\n--- TOTAL SALES ---")

cursor.execute("""
SELECT SUM(amount)
FROM orders
""")

total_sales = cursor.fetchone()[0]

print("Total sales:", total_sales)


# ------------------------------------------------------------
# 25.5 - Average Order Value
# ------------------------------------------------------------

print("\n--- AVERAGE ORDER VALUE ---")

cursor.execute("""
SELECT AVG(amount)
FROM orders
""")

average_order = cursor.fetchone()[0]

print("Average order value:", average_order)


# ------------------------------------------------------------
# 25.6 - Completed Orders
# ------------------------------------------------------------

print("\n--- COMPLETED ORDERS ---")

cursor.execute("""
SELECT *
FROM orders
WHERE status = ?
""", ("Completed",))

for row in cursor.fetchall():
    print(row)


# ------------------------------------------------------------
# 25.7 - Hyderabad Customers
# ------------------------------------------------------------

print("\n--- HYDERABAD CUSTOMERS ---")

cursor.execute("""
SELECT name, email
FROM customers
WHERE city = ?
""", ("Hyderabad",))

for row in cursor.fetchall():
    print(row)


# ------------------------------------------------------------
# 25.8 - Highest Value Order
# ------------------------------------------------------------

print("\n--- HIGHEST VALUE ORDER ---")

cursor.execute("""
SELECT *
FROM orders
ORDER BY amount DESC
LIMIT 1
""")

highest_order = cursor.fetchone()

print(highest_order)


