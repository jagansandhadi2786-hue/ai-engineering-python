# ============================================================
# EXERCISE 13 - SUM
# ============================================================
#
# THEORY:
#
# SUM() calculates the total of numeric values.
#
# We need an orders table for this exercise.
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 13 - SUM")
print("=" * 70)

cursor.execute("""
CREATE TABLE IF NOT EXISTS orders (
    order_id INTEGER PRIMARY KEY,
    customer_id INTEGER,
    product TEXT,
    amount REAL,
    status TEXT
)
""")

orders = [
    (101, 1, "Laptop", 80000, "Completed"),
    (102, 1, "Mouse", 1500, "Completed"),
    (103, 2, "Keyboard", 3000, "Pending"),
    (104, 3, "Monitor", 20000, "Completed"),
    (105, 4, "Laptop", 75000, "Completed"),
]

cursor.executemany("""
INSERT OR IGNORE INTO orders
(order_id, customer_id, product, amount, status)
VALUES (?, ?, ?, ?, ?)
""", orders)

connection.commit()

cursor.execute("""
SELECT SUM(amount)
FROM orders
""")

total = cursor.fetchone()[0]

print("Total order amount:", total)


# ============================================================
# EXERCISE 14 - AVG
