import sqlite3


# ============================================================
# EXERCISE 1 - CONNECT TO SQLITE DATABASE
# ============================================================
#
# THEORY:
#
# sqlite3.connect() creates a connection to a SQLite database.
#
# If the database file does not exist, SQLite creates it.
#
# Example:
#
# connection = sqlite3.connect("customers.db")
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 1 - DATABASE CONNECTION")
print("=" * 70)

connection = sqlite3.connect("customers.db")

print("Connected to SQLite database successfully")


# ============================================================
# EXERCISE 2 - CREATE A TABLE
# ============================================================
#
# THEORY:
#
# CREATE TABLE creates a new database table.
#
# PRIMARY KEY uniquely identifies each row.
#
# TEXT stores text.
# INTEGER stores whole numbers.
# REAL stores decimal numbers.
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 2 - CREATE TABLE")
print("=" * 70)

cursor = connection.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS customers (
    customer_id INTEGER PRIMARY KEY,
    name TEXT,
    email TEXT,
    city TEXT,
    age INTEGER
)
""")

connection.commit()

print("Customers table created")


# ============================================================
# EXERCISE 3 - INSERT DATA
# ============================================================
#
# THEORY:
#
# INSERT INTO adds new records to a table.
#
# Always prefer ? placeholders instead of building SQL strings
# manually.
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 3 - INSERT DATA")
print("=" * 70)

customers = [
    (1, "Jagan", "jagan@example.com", "Hyderabad", 30),
    (2, "Ravi", "ravi@example.com", "Bangalore", 28),
    (3, "Priya", "priya@example.com", "Chennai", 26),
    (4, "Anita", "anita@example.com", "Hyderabad", 32),
    (5, "Rahul", "rahul@example.com", "Mumbai", 35),
]

cursor.executemany("""
INSERT OR IGNORE INTO customers
(customer_id, name, email, city, age)
VALUES (?, ?, ?, ?, ?)
""", customers)

connection.commit()

print("Customer records inserted")


# ============================================================
# EXERCISE 4 - SELECT ALL RECORDS
# ============================================================
#
# THEORY:
#
# SELECT retrieves data from a table.
#
# SELECT * means:
# "Return all columns."
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 4 - SELECT ALL CUSTOMERS")
print("=" * 70)

cursor.execute("""
SELECT * FROM customers
""")

rows = cursor.fetchall()

for row in rows:
    print(row)


# ============================================================
# EXERCISE 5 - WHERE
# ============================================================
#
# THEORY:
#
# WHERE filters records.
#
# Example:
#
# SELECT * FROM customers
# WHERE city = 'Hyderabad'
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 5 - WHERE")
print("=" * 70)

cursor.execute("""
SELECT *
FROM customers
WHERE city = ?
""", ("Hyderabad",))

rows = cursor.fetchall()

for row in rows:
    print(row)


# ============================================================
# EXERCISE 6 - COMPARISON OPERATORS
# ============================================================
#
# THEORY:
#
# SQL comparison operators:
#
# =       equal
# >       greater than
# <       less than
# >=      greater than or equal
# <=      less than or equal
# !=      not equal
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 6 - COMPARISON OPERATORS")
print("=" * 70)

cursor.execute("""
SELECT name, age
FROM customers
WHERE age >= ?
""", (30,))

rows = cursor.fetchall()

for row in rows:
    print(row)


# ============================================================
# EXERCISE 7 - AND / OR
# ============================================================
#
# THEORY:
#
# AND:
# Both conditions must be true.
#
# OR:
# At least one condition must be true.
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 7 - AND / OR")
print("=" * 70)

cursor.execute("""
SELECT name, city, age
FROM customers
WHERE city = ?
AND age >= ?
""", ("Hyderabad", 30))

rows = cursor.fetchall()

for row in rows:
    print(row)


# ============================================================
# EXERCISE 8 - ORDER BY
# ============================================================
#
# THEORY:
#
# ORDER BY sorts results.
#
# ASC  = ascending
# DESC = descending
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 8 - ORDER BY")
print("=" * 70)

cursor.execute("""
SELECT name, age
FROM customers
ORDER BY age DESC
""")

rows = cursor.fetchall()

for row in rows:
