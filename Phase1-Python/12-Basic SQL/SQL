# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 10 - UPDATE")
print("=" * 70)

cursor.execute("""
UPDATE customers
SET city = ?
WHERE customer_id = ?
""", ("Delhi", 5))

connection.commit()

print("Customer updated")


# ============================================================
# EXERCISE 11 - DELETE
# ============================================================
#
# THEORY:
#
# DELETE removes records.
#
# IMPORTANT:
#
# Always use WHERE unless you intentionally want to delete
