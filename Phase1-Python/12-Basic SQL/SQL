print("\n" + "=" * 70)
print("EXERCISE 23 - LEFT JOIN")
print("=" * 70)

cursor.execute("""
SELECT
    customers.name,
    orders.product,
    orders.amount
FROM customers
LEFT JOIN orders
ON customers.customer_id = orders.customer_id
""")

rows = cursor.fetchall()

for row in rows:
    print(row)


