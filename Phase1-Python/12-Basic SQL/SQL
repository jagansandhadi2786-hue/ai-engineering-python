# ============================================================
# EXERCISE 9 - LIMIT
# ============================================================
#
# THEORY:
#
# LIMIT restricts the number of returned rows.
#
# ============================================================

print("\n" + "=" * 70)
print("EXERCISE 9 - LIMIT")
print("=" * 70)

cursor.execute("""
SELECT *
FROM customers
ORDER BY age DESC
LIMIT 3
""")

rows = cursor.fetchall()

for row in rows:
