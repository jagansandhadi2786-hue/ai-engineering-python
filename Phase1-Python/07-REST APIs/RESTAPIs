# EXERCISE 25 - MINI PROJECT
# CUSTOMER API INTEGRATION
# ============================================================

print("\n")
print("=" * 60)
print("EXERCISE 25 - CUSTOMER API MINI PROJECT")
print("=" * 60)


# ------------------------------------------------------------
# STEP 1 - API URL
# ------------------------------------------------------------

url = "https://jsonplaceholder.typicode.com/users"


try:

    # --------------------------------------------------------
    # STEP 2 - Call REST API
    # --------------------------------------------------------

    response = requests.get(
        url,
        timeout=10
    )

    response.raise_for_status()

    print("API request successful")


    # --------------------------------------------------------
    # STEP 3 - Convert Response to Python
    # --------------------------------------------------------

    users = response.json()

    print(
        "Number of users:",
        len(users)
    )


    # --------------------------------------------------------
    # STEP 4 - Create Customer List
    # --------------------------------------------------------

    customers = []


    for user in users:

        customer = {

            "customer_id": user["id"],

            "name": user["name"],

            "email": user["email"],

            "city": user["address"]["city"],

            "company": user["company"]["name"]

        }

        customers.append(customer)


    # --------------------------------------------------------
    # STEP 5 - Display Customers
    # --------------------------------------------------------

    print("\nCustomer Data")

    print("=" * 60)


    for customer in customers:

        print(
            json.dumps(
                customer,
                indent=4
            )
        )


    # --------------------------------------------------------
    # STEP 6 - Save API Data to JSON File
    # --------------------------------------------------------

    with open(
        "customers_from_api.json",
        "w"
    ) as file:

        json.dump(
            customers,
            file,
            indent=4
        )


    print(
        "\ncustomers_from_api.json "
        "created successfully"
    )


    # --------------------------------------------------------
    # STEP 7 - Read Saved JSON File
    # --------------------------------------------------------

    with open(
        "customers_from_api.json",
        "r"
    ) as file:

        saved_customers = json.load(file)


    print(
        "\nCustomers loaded from JSON file:",
        len(saved_customers)
    )


    # --------------------------------------------------------
    # STEP 8 - Search Customer
    # --------------------------------------------------------

    search_id = 3

    for customer in saved_customers:

        if customer["customer_id"] == search_id:

            print("\nCustomer Found:")

            print(
                json.dumps(
                    customer,
                    indent=4
                )
            )


except requests.exceptions.Timeout:

    print("API request timed out")


except requests.exceptions.RequestException as error:

    print("API request failed")

    print("Error:", error)


except json.JSONDecodeError:

    print("Invalid JSON response")


