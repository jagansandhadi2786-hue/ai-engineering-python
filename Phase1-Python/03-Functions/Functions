# ============================================================
# EXERCISE 22 - Calculate List Total
# ============================================================

def calculate_total(numbers):

    total = 0

    for number in numbers:
        total = total + number

    return total


numbers = [10, 20, 30, 40]

result = calculate_total(numbers)

print("List Total:", result)


