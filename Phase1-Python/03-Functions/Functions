def process_order(order):

    total = order["amount"] * order["quantity"]

    print("Order ID:", order["orderId"])
    print("Customer ID:", order["customerId"])
    print("Amount:", order["amount"])
    print("Quantity:", order["quantity"])
    print("Total:", total)


