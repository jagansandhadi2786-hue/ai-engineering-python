# AI EMPLOYEE ASSISTANT SYSTEM
# ============================================================

class AIEmployee:

    company = "AI Technologies"

    def __init__(
        self,
        employee_id,
        name,
        department
    ):
        self.employee_id = employee_id
        self.name = name
        self.department = department

    def display(self):

        print("Employee ID:", self.employee_id)
        print("Name:", self.name)
        print("Department:", self.department)

    def work(self):

        print(self.name, "is working")


class DeveloperEmployee(AIEmployee):

    def __init__(
        self,
        employee_id,
        name,
        department,
        programming_language
    ):
        super().__init__(
            employee_id,
            name,
            department
        )

        self.programming_language = programming_language

    def work(self):

        print(
            self.name,
            "is developing software using",
            self.programming_language
        )


class AIEngineer(DeveloperEmployee):

    def __init__(
        self,
        employee_id,
        name,
        department,
        programming_language,
        specialization,
        model
    ):
        super().__init__(
            employee_id,
            name,
            department,
            programming_language
        )

        self.specialization = specialization
        self.model = model

    def build_model(self):

        print(
            self.name,
            "is building a",
            self.specialization,
            "solution"
        )

    def call_model(self):

        print(
            "Calling AI model:",
            self.model
        )

    def display(self):

        super().display()

        print(
            "Programming Language:",
            self.programming_language
        )

        print(
            "Specialization:",
            self.specialization
        )

        print(
            "AI Model:",
            self.model
        )

        print("--------------------")


ai_engineer = AIEngineer(
    "E1001",
    "Jagan",
    "AI Engineering",
    "Python",
    "Generative AI",
    "Azure OpenAI"
)

ai_engineer.display()

ai_engineer.work()

ai_engineer.build_model()

ai_engineer.call_model()

