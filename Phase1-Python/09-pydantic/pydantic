print("\n" + "=" * 60)
print("EXERCISE 20 - CUSTOM VALIDATION")
print("=" * 60)


class ValidatedUser(BaseModel):
    username: str

    @field_validator("username")
    @classmethod
    def validate_username(cls, value):

        if " " in value:

            raise ValueError(
                "Username cannot contain spaces"
            )

        return value


valid_user = ValidatedUser(
    username="Jagan",
)

print(valid_user)


try:

    invalid_user = ValidatedUser(
        username="Jagan Reddy",
    )

except ValidationError as error:

    print("Custom validation error:")
    print(error)


