class MiniProjectCustomer(BaseModel):

    customer_id: str

    name: str

    email: EmailStr


class MiniProjectOrder(BaseModel):

    order_id: str

    customer: MiniProjectCustomer

    order_type: Literal["B2B", "B2C"]

    amount: float = Field(
        gt=0,
    )

    items: list[str]


order_data = {
    "order_id": "ORD1001",

    "customer": {
        "customer_id": "C101",
        "name": "Jagan",
        "email": "jagan@example.com",
    },

    "order_type": "B2B",

    "amount": 500,

    "items": [
        "Laptop",
        "Mouse",
    ],
}


try:

    order = MiniProjectOrder.model_validate(
        order_data
    )

    print("\nVALID ORDER")

    print("\nComplete object:")

    print(order)

    print("\nOrder ID:")

    print(order.order_id)

    print("\nCustomer ID:")

    print(order.customer.customer_id)

    print("\nCustomer Name:")

    print(order.customer.name)

    print("\nCustomer Email:")

    print(order.customer.email)

    print("\nOrder Type:")

    print(order.order_type)

    print("\nAmount:")

    print(order.amount)

    print("\nItems:")

    print(order.items)

    print("\nDictionary:")

    print(order.model_dump())

    print("\nJSON:")

    print(order.model_dump_json(indent=2))


except ValidationError as error:

    print("\nORDER VALIDATION FAILED")

    print(error)


