# WHAT IS REQUESTS?
#
# requests is a Python library used to communicate with
# web servers and REST APIs using HTTP.
#
# Common methods:
#
# GET     -> Read data
# POST    -> Create data
# PUT     -> Replace/update data
# PATCH   -> Partially update data
# DELETE  -> Delete data
#
# ============================================================
#
# IMPORTANT REQUESTS FUNCTIONS
#
# requests.get()
# requests.post()
# requests.put()
# requests.patch()
# requests.delete()
#
# ============================================================
#
# IMPORTANT RESPONSE ATTRIBUTES
#
# response.status_code
# response.text
# response.json()
# response.headers
# response.url
#
# ============================================================
