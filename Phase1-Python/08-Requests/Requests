def create_post(title, body, user_id):

    url = "https://jsonplaceholder.typicode.com/posts"

    data = {

        "title": title,

        "body": body,

        "userId": user_id

    }

    response = requests.post(
        url,
        json=data,
        timeout=10
    )

    response.raise_for_status()

    return response.json()


try:

    result = create_post(
        "Python API",
        "Learning Requests",
        1
    )

    print("Created Post:")

    print(result)

except requests.exceptions.RequestException as error:

    print("API Error:",
          error)


