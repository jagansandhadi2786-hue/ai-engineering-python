print("\n")
print("=" * 60)
print("EXERCISE 25 - MINI PROJECT")
print("REST API CUSTOMER PROCESSING")
print("=" * 60)


# ------------------------------------------------------------
# STEP 1 - API URL
# ------------------------------------------------------------

url = "https://jsonplaceholder.typicode.com/users"


try:

    # --------------------------------------------------------
    # STEP 2 - GET API Data
    # --------------------------------------------------------

    response = requests.get(
        url,
        timeout=10
    )

    response.raise_for_status()

    print("\nAPI request successful")


    # --------------------------------------------------------
    # STEP 3 - Convert Response to JSON
    # --------------------------------------------------------

    users = response.json()

    print(
        "Total users:",
        len(users)
    )


    # --------------------------------------------------------
    # STEP 4 - Create Customer List
    # --------------------------------------------------------

    customers = []


    for user in users:

        customer = {

            "customer_id":
                user["id"],

            "customer_name":
                user["name"],

            "email":
                user["email"],

            "city":
                user["address"]["city"],

            "company":
                user["company"]["name"]

        }

        customers.append(customer)


    # --------------------------------------------------------
    # STEP 5 - Display Customers
    # --------------------------------------------------------

    print("\nCustomer Records")

    print("=" * 60)


    for customer in customers:

        print(
            "Customer ID:",
            customer["customer_id"]
        )

        print(
            "Name:",
            customer["customer_name"]
        )

        print(
            "Email:",
            customer["email"]
        )

        print(
            "City:",
            customer["city"]
        )

        print(
            "Company:",
            customer["company"]
        )

        print("-" * 60)


    # --------------------------------------------------------
    # STEP 6 - Search Customer
    # --------------------------------------------------------

    search_id = 3

    print("\nSearching Customer:",
          search_id)


    found = False


    for customer in customers:

        if customer["customer_id"] == search_id:

            print("\nCustomer Found")

            print(customer)

            found = True


    if not found:

        print("Customer not found")


    # --------------------------------------------------------
    # STEP 7 - Create New Customer Using POST
    # --------------------------------------------------------

    new_customer = {

        "customer_id": "C999",

        "name": "AI Engineer",

        "city": "Hyderabad",

        "email": "ai@example.com"

    }


    post_url = (
        "https://jsonplaceholder.typicode.com/posts"
    )


    post_response = requests.post(

        post_url,

        json=new_customer,

        timeout=10
    )


    post_response.raise_for_status()


    created_customer = (
        post_response.json()
    )


    print("\nPOST Response")

    print(created_customer)


except requests.exceptions.Timeout:

    print("API request timed out")


except requests.exceptions.HTTPError as error:

    print("HTTP Error:",
          error)


except requests.exceptions.RequestException as error:

    print("Request Error:",
          error)


